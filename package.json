{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "uzhavar-connect",
  "version": "1.0.0",
  "description": "Uzhavar Connect - Agricultural Services Platform",
  "main": "server/index.js",
  "scripts": {
    "build": "npm install && npm install --prefix server && npm install --prefix client && npm run build --prefix client",
    "dev": "concurrently \"npm start --prefix server\" \"npm start --prefix client\"",
    "start": "npm start --prefix server",
    "prod": "cross-env NODE_ENV=production npm start --prefix server"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  },
  "keywords": [],
  "author": "Uzhavar Team",
  "license": "ISC"
}
